// ############################## //
// MAP DATA FGD (FORGE GAME DATA) //
// ############################## //

//
// worldspawn
//

@SolidClass = worldspawn : "World entity"
[
	message(string) : "Text on entering the world"
	worldtype(choices) : "Ambience" : 0 =
	[
		0 : "Medieval"
		1 : "Metal (runic)"
		2 : "Base"
	]
	sounds(integer) : "CD track to play" : 0
	light(integer) : "Ambient light"
	_sunlight(integer) : "Sunlight"
	_sun_mangle(string) : "Sun mangle (Yaw pitch roll)"
]

@baseclass = brush : "Any kind of brush in the world"
[
	sector(integer) : "Sector Group Tag [int]"
]

@baseclass = Angle [ angle(integer) : "Direction" ]
@baseclass = Appearflags [
	spawnflags(Flags) =
	[
		256 : "Not on Easy" : 0
		512 : "Not on Normal" : 0
		1024 : "Not on Hard" : 0
		2048 : "Not in Deathmatch" : 0
	]
]

@baseclass = Targetname [ targetname(target_source) : "Name" ]
@baseclass = Target [
	target(target_destination) : "Target"
	killtarget(target_destination) : "Killtarget"
]

//Default Brush
@SolidClass base(brush) = func_default : "All brushes must inherit from this if to be culled" []

//Portal Brush
@SolidClass base(brush) = func_portal : "Portal" 
[
	show_sector(integer) : "Which sector to show when looking at, or after colliding with this portal"
	hide_sector(integer) : "Which sector to hide when NOT looking at, or after colliding with this portal"
]

//Water
@SolidClass base(brush) = func_water : "Water" 
[
	alpha(float) : "Alpha" : 0.8 : "How transparent the liquid is"
	is_dangerous(choices) : "Is this liquid dangerous?" : 0 =
	[
		0 : "FALSE"
		1 : "TRUE"
	]
]

// Player Class
@baseclass base(Appearflags) size(-16 -16 -24, 16 16 32) color(0 255 0) model({ "path": "models/9mm.glb" }) = PlayerClass []

@PointClass base(PlayerClass) = info_player_start : "Player 1 start" []


// Monster Class
@baseclass base(Appearflags) size(-16 -16 -24, 16 16 32) color(0 255 0) model({ "path": "models/9mm.glb" }) = MonsterClass []

//Monster Shotgunner
@PointClass base(MonsterClass) = monster_shotgunner : "Monster Shotgunner" []

//Light
@PointClass base(Appearflags) = light : "Light" 
[
	color(color255) : "Color" : "255 255 255"
	alpha(float) : "Alpha" : 255.0 : "The transparency of the light color"
	brightness(float) : "Brightness" : 0.6 : "How bright the light is." 
	radius(float) : "Radius" : 40.0 : "How big the light is."
	
]



